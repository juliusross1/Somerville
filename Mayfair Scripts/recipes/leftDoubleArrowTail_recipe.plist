<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>leftDoubleArrowTail</string>
	<key>kind</key>
	<string>recipe</string>

  <key>constants</key>
  <string>recipe_constants.plist</string>
	<key>description</key>
	<string>Build leftDoubleArrowTail from existing tail and extender parts with a horizontal math assembly.</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key><string>createGlyph</string>
			<key>glyph</key><string>leftDoubleArrowTail</string>
			<key>export</key><true/>
			<key>color</key><string>${GeneratedColor}</string>
		</dict>
		<dict>
			<key>action</key><string>addComponents</string>
			<key>glyph</key><string>leftDoubleArrowTail</string>
			<key>components</key>
			<array>
				<string>Arrowend.lft</string>
				<string>Arrow.mid</string>
				<string>leftTailArrow.rgt</string>
			</array>
		</dict>
		<dict>
			<key>action</key><string>setMathPluginAssembly</string>
			<key>glyph</key><string>leftDoubleArrowTail</string>
			<key>direction</key><string>h</string>
			<key>parts</key>
			<array>
				<dict>
					<key>glyph</key><string>Arrowend.lft</string>
					<key>extender</key><false/>
					<key>startConnector</key><integer>30</integer>
					<key>endConnector</key><integer>30</integer>
				</dict>
				<dict>
					<key>glyph</key><string>Arrow.ext</string>
					<key>extender</key><true/>
					<key>startConnector</key><integer>450</integer>
					<key>endConnector</key><integer>450</integer>
				</dict>
				<dict>
					<key>glyph</key><string>leftTailArrow.rgt</string>
					<key>extender</key><false/>
					<key>startConnector</key><string>${ArrowStartandEndConnector}</string>
					<key>endConnector</key><integer>0</integer>
				</dict>
			</array>
		</dict>
		<dict>
			<key>action</key><string>enableComponentAlignment</string>
			<key>glyph</key><string>leftDoubleArrowTail</string>
		</dict>
		<dict>
			<key>action</key><string>updateMetrics</string>
			<key>glyph</key><string>leftDoubleArrowTail</string>
		</dict>
	</array>
</dict>
</plist>
