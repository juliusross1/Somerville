<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>formatVersion</key>
  <integer>1</integer>

  <key>kind</key>
  <string>template</string>

  <key>name</key>
  <string>doubleArrowParts</string>

  <key>parameters</key>
  <dict>
    <key>leftArrowBase</key>
    <string>leftDoubleArrow</string>
    <key>rightArrowBase</key>
    <string>rightDoubleArrow</string>
    <key>leftPartSuffix</key>
    <string>.lft</string>
    <key>rightPartSuffix</key>
    <string>.rgt</string>
    <key>color</key>
    <string>orange</string>
  </dict>

  <key>actions</key>
  <array>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${rightPartSuffix}</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${rightPartSuffix}</string>
        <key>component</key>
        <string>${rightArrowBase}${leftPartSuffix}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>flipComponentsAcrossYAxis</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${rightPartSuffix}</string>
        <key>components</key>
        <array>
          <string>${rightArrowBase}${leftPartSuffix}</string>
        </array>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setSideMetricKeys</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${rightPartSuffix}</string>
        <key>leftMetricsKey</key>
        <string>=|${leftArrowBase}${rightPartSuffix}</string>
        <key>rightMetricsKey</key>
        <string>=|${leftArrowBase}${rightPartSuffix}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>updateMetrics</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${rightPartSuffix}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${leftPartSuffix}</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${leftPartSuffix}</string>
        <key>component</key>
        <string>${rightArrowBase}${rightPartSuffix}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>flipComponentsAcrossYAxis</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${leftPartSuffix}</string>
        <key>components</key>
        <array>
          <string>${rightArrowBase}${rightPartSuffix}</string>
        </array>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setSideMetricKeys</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${leftPartSuffix}</string>
        <key>leftMetricsKey</key>
        <string>=|${leftArrowBase}${leftPartSuffix}</string>
        <key>rightMetricsKey</key>
        <string>=|${leftArrowBase}${leftPartSuffix}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>updateMetrics</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>${leftArrowBase}${leftPartSuffix}</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
