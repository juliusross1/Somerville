<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>formatVersion</key>
  <integer>1</integer>
  <key>kind</key>
  <string>recipe</string>

  <key>constants</key>
  <string>recipe_constants.plist</string>
  <key>name</key>
  <string>contourIntegral</string>
  <key>parameters</key>
  <dict>
    <key>axis</key>
    <string>height</string>
    <key>color</key>
    <string>orange</string>
    <key>highValue</key>
    <integer>100</integer>
    <key>lowValue</key>
    <integer>0</integer>
    <key>variantValues</key>
    <array>
      <integer>0</integer>
      <integer>5</integer>
      <integer>10</integer>
      <integer>15</integer>
      <integer>20</integer>
      <integer>25</integer>
      <integer>30</integer>
      <integer>35</integer>
      <integer>40</integer>
      <integer>45</integer>
      <integer>50</integer>
      <integer>55</integer>
      <integer>60</integer>
      <integer>65</integer>
      <integer>70</integer>
      <integer>75</integer>
      <integer>80</integer>
      <integer>85</integer>
      <integer>90</integer>
      <integer>95</integer>
      <integer>100</integer>
    </array>
  </dict>
  <key>actions</key>
  <array>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>export</key>
        <false/>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponents</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>components</key>
        <array>
          <string>_smart.integral</string>
          <string>_smart.circle</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createHighLayers</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>axis</key>
        <string>${axis}</string>
        <key>lowValue</key>
        <string>${lowValue}</string>
        <key>highValue</key>
        <string>${highValue}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisLowHigh</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>axis</key>
        <string>${axis}</string>
        <key>lowValue</key>
        <string>${lowValue}</string>
        <key>highValue</key>
        <string>${highValue}</string>
        <key>componentFilter</key>
        <dict>
          <key>components</key>
          <array>
            <string>_smart.integral</string>
          </array>
        </dict>
      </dict>
    </dict>
    <!--
      Smart-component gotcha: _smart.circle also has a height axis, but in
      contourIntegral it must stay on the low-height shape on every layer.
      Only _smart.integral gets low/high height values. If _smart.circle is
      allowed to use its own High layer, Glyphs draws the huge circle and its
      _center anchor is thousands of units away.
    -->
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisValue</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>axis</key>
        <string>${axis}</string>
        <key>value</key>
        <string>${lowValue}</string>
        <key>componentFilter</key>
        <dict>
          <key>components</key>
          <array>
            <string>_smart.circle</string>
          </array>
        </dict>
      </dict>
    </dict>
    <!--
      Scale the pinned low-height circle before anchor alignment. On High
      layers, the mark anchor lookup below must use _smart.circle's associated
      master layer, not _smart.circle's High layer, or the placement jumps far
      off-center.
    -->
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentScaleByLayerName</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>componentFilter</key>
        <dict>
          <key>components</key>
          <array>
            <string>_smart.circle</string>
          </array>
        </dict>
        <key>rules</key>
        <array>
          <dict>
            <key>contains</key>
            <array>
              <string>Agate</string>
              <string>Black</string>
            </array>
            <key>scale</key>
            <real>1.8</real>
          </dict>
          <dict>
            <key>contains</key>
            <array>
              <string>Agate</string>
            </array>
            <key>scale</key>
            <real>1.5</real>
          </dict>
          <dict>
            <key>contains</key>
            <array>
              <string>Needlepoint</string>
            </array>
            <key>scale</key>
            <integer>3</integer>
          </dict>
        </array>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>alignComponentPairsByAnchors</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>_smart.contourIntegral</string>
        <key>components</key>
        <array>
          <string>_smart.integral</string>
          <string>_smart.circle</string>
        </array>
        <key>pairs</key>
        <array>
          <dict>
            <key>componentIndexes</key>
            <array>
              <integer>0</integer>
              <integer>1</integer>
            </array>
            <key>baseAnchor</key>
            <string>center</string>
            <key>markAnchor</key>
            <string>_center</string>
            <key>markUseAssociatedMasterLayer</key>
            <true/>
          </dict>
        </array>
        <key>disableAlignment</key>
        <true/>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>contourIntegral</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>contourIntegral</string>
        <key>component</key>
        <string>_smart.contourIntegral</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createSmartComponentVariants</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>contourIntegral</string>
        <key>axis</key>
        <string>${axis}</string>
        <key>values</key>
        <string>${variantValues}</string>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
