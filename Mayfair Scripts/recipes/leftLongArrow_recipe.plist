<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Left Long Arrow</string>
	<key>kind</key>
	<string>recipe</string>

  <key>constants</key>
  <string>recipe_constants.plist</string>
	<key>description</key>
	<string>Build leftArrow from left, extender, and right arrow parts with a horizontal math assembly.</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<string>createGlyph</string>
			<key>glyph</key>
			<string>leftLongArrow</string>
			<key>export</key>
			<true/>
			<key>color</key>
			<string>${GeneratedColor}</string>
		</dict>
		<dict>
			<key>action</key>
			<string>addComponents</string>
			<key>glyph</key>
			<string>leftLongArrow</string>
			<key>components</key>
			<array>
				<string>ArrowLong.mid</string>
				<string>leftArrow.lft</string>
				<string>leftArrow.rgt</string>
			</array>
		</dict>
		<dict>
			<key>action</key>
			<string>setMathPluginAssembly</string>
			<key>glyph</key>
			<string>leftLongArrow</string>
			<key>direction</key>
			<string>h</string>
			<key>parts</key>
			<array>
				<dict>
					<key>glyph</key>
					<string>leftArrow.lft</string>
					<key>extender</key>
					<false/>
					<key>startConnector</key>
					<integer>0</integer>
					<key>endConnector</key>
					<string>${ArrowStartandEndConnector}</string>
				</dict>
				<dict>
					<key>glyph</key>
					<string>Arrow.mid</string>
					<key>extender</key>
					<true/>
					<key>startConnector</key>
					<string>${ArrowMiddleConnector}</string>
					<key>endConnector</key>
					<string>${ArrowMiddleConnector}</string>
				</dict>
				<dict>
					<key>glyph</key>
					<string>leftArrow.rgt</string>
					<key>extender</key>
					<false/>
					<key>startConnector</key>
					<string>${ArrowStartandEndConnector}</string>
					<key>endConnector</key>
					<integer>0</integer>
				</dict>
			</array>
		</dict>
		<dict>
			<key>action</key>
			<string>enableComponentAlignment</string>
			<key>glyph</key>
			<string>leftLongArrow</string>
		</dict>
		<dict>
			<key>action</key>
			<string>updateMetrics</string>
			<key>glyph</key>
			<string>leftLongArrow</string>
		</dict>
	</array>
</dict>
</plist>
