<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>leftAndRightArrow</string>
  <key>kind</key>
  <string>recipe</string>
  <key>constants</key>
  <string>recipe_constants.plist</string>
  <key>description</key>
  <string>Build leftAndRightArrow and its horizontal math assembly.</string>
  <key>actions</key>
  <array>
    <dict>
      <key>action</key>
      <string>createGlyph</string>
      <key>glyph</key>
      <string>leftAndRightArrow</string>
      <key>export</key>
      <true/>
      <key>color</key>
      <string>${GeneratedColor}</string>
    </dict>
    <dict>
      <key>action</key>
      <string>addComponents</string>
      <key>glyph</key>
      <string>leftAndRightArrow</string>
      <key>components</key>
      <array>
        <string>DoublePairedArrow.mid</string>
        <string>rightOverLeftArrow.lft</string>
        <string>rightOverLeftArrow.rgt</string>
      </array>
    </dict>
    <dict>
      <key>action</key>
      <string>setMathPluginAssembly</string>
      <key>glyph</key>
      <string>leftAndRightArrow</string>
      <key>direction</key>
      <string>h</string>
      <key>parts</key>
      <array>
        <dict>
          <key>glyph</key>
        <string>rightOverLeftArrow.lft</string>
          <key>extender</key>
          <false/>
          <key>startConnector</key>
          <integer>0</integer>
          <key>endConnector</key>
          <string>${ArrowStartandEndConnector}</string>
        </dict>
        <dict>
          <key>glyph</key>
          <string>DoublePairedArrow.ext</string>
          <key>extender</key>
          <true/>
          <key>startConnector</key>
          <string>${ArrowMiddleConnector}</string>
          <key>endConnector</key>
          <string>${ArrowMiddleConnector}</string>
        </dict>
        <dict>
          <key>glyph</key>
        <string>rightOverLeftArrow.rgt</string>
          <key>extender</key>
          <false/>
          <key>startConnector</key>
          <string>${ArrowStartandEndConnector}</string>
          <key>endConnector</key>
          <integer>0</integer>
        </dict>
      </array>
    </dict>
    <dict>
      <key>action</key>
      <string>enableComponentAlignment</string>
      <key>glyph</key>
      <string>leftAndRightArrow</string>
    </dict>
    <dict>
      <key>action</key>
      <string>updateMetrics</string>
      <key>glyph</key>
      <string>leftAndRightArrow</string>
    </dict>
  </array>
</dict>
</plist>
