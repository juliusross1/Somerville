<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MathML test</title>
  <style>
    @font-face {
      font-family: "SomervilleVF";
      src:
        local("Somerville Somerville Variable"),
        local("SomervilleSomervilleVariable-SomervilleVariable"),
        url("./SomervilleVF-withMathtable.ttf") format("truetype");
      font-weight: 360 900;
      font-stretch: 94% 114%;
      font-style: normal;
      font-display: block;
    }

    @font-face {
      font-family: "PlayfairVF";
      src: url("./PlayfairRomanVF.ttf") format("truetype");
      font-weight: 360 900;
      font-stretch: 94% 114%;
      font-style: normal;
      font-display: block;
    }

    :root {
      --wght: 400;
      --opsz: 12;
      --wdth: 100;
      --math-size: 88px;
      --grid-size: 1em;
      --somerville-fraction-rule-thickness: 0.0371em;
      color: #1c1c1c;
      background: #f7f5f0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr;
    }

    main {
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: clamp(12px, 3vw, 36px);
      display: grid;
    }

    .control-panel {
      position: sticky;
      top: 0;
      z-index: 1;
      padding: 8px clamp(12px, 3vw, 32px) 10px;
      border-bottom: 1px solid #d7d0c3;
      background: #fffdfa;
    }

    .control-panel[hidden] {
      display: none;
    }

    .panel-toggle {
      position: fixed;
      top: 8px;
      right: 8px;
      z-index: 2;
      min-width: 34px;
      height: 28px;
      border: 1px solid #b8ad9d;
      border-radius: 6px;
      color: #524a40;
      background: #fffdfa;
      font: 700 0.78rem/1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      cursor: pointer;
    }

    .controls {
      width: min(1120px, 100%);
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(110px, 1fr)) auto repeat(4, minmax(95px, 1fr));
      gap: 8px;
      align-items: end;
    }

    label {
      display: grid;
      gap: 3px;
      font-size: 0.74rem;
      font-weight: 600;
    }

    .value {
      font-variant-numeric: tabular-nums;
      font-weight: 500;
      color: #645c51;
    }

    .value input {
      width: 5.5em;
      padding: 2px 4px;
      border: 1px solid #c9c1b3;
      border-radius: 4px;
      background: #fffdfa;
      color: #1c1c1c;
      font: inherit;
      font-variant-numeric: tabular-nums;
    }

    .axis-name {
      min-height: 1em;
      color: #645c51;
      font-size: 0.68rem;
      font-weight: 500;
      line-height: 1;
    }

    .shortcut-help {
      width: min(1120px, 100%);
      margin: 6px auto 0;
      color: #645c51;
      font-size: 0.72rem;
      line-height: 1.28;
    }

    .font-status {
      width: min(1120px, 100%);
      margin: 6px auto 0;
      color: #645c51;
      font-size: 0.72rem;
      line-height: 1.28;
      font-variant-numeric: tabular-nums;
    }

    .font-status time {
      color: #1c1c1c;
      font-weight: 600;
    }

    .refresh-toast {
      position: fixed;
      inset: 50% auto auto 50%;
      z-index: 10;
      display: grid;
      place-items: center;
      width: 92px;
      height: 92px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      border-radius: 999px;
      color: #fffdfa;
      background: rgba(28, 28, 28, 0.68);
      box-shadow: 0 18px 40px rgba(28, 28, 28, 0.22);
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -50%) scale(0.92);
      transition: opacity 180ms ease, transform 180ms ease;
      backdrop-filter: blur(6px);
    }

    .refresh-toast.is-visible {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .refresh-toast.is-sticky {
      cursor: pointer;
      pointer-events: auto;
    }

    .refresh-toast.is-failed {
      background: rgba(126, 42, 42, 0.86);
      box-shadow: 0 18px 40px rgba(126, 42, 42, 0.28);
    }

    .refresh-toast-content {
      display: grid;
      gap: 6px;
      justify-items: center;
      font-size: 0.68rem;
      font-weight: 700;
      line-height: 1;
    }

    .refresh-toast-icon {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border: 3px solid rgba(255, 253, 250, 0.35);
      border-top-color: #fffdfa;
      border-radius: 999px;
      animation: refresh-spin 850ms linear infinite;
      font-size: 1.25rem;
    }

    .refresh-toast.is-done .refresh-toast-icon {
      border-color: transparent;
      animation: none;
    }

    .refresh-toast.is-failed .refresh-toast-icon {
      border-color: transparent;
      animation: none;
    }

    @keyframes refresh-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .extra-controls {
      margin-top: 8px;
    }

    .extra-controls .font-status {
      grid-column: 1 / -1;
      width: 100%;
      margin: 0;
    }

    .extra-controls[hidden] {
      display: none;
    }

    input[type="range"] {
      width: 100%;
      accent-color: #2c6f69;
    }

    input[type="checkbox"] {
      accent-color: #2c6f69;
    }

    .lock-control {
      display: grid;
      place-items: center;
      min-width: 30px;
      padding-bottom: 1px;
    }

    .lock-control input {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .lock-icon {
      display: grid;
      place-items: center;
      inline-size: 26px;
      block-size: 26px;
      border: 1px solid #b8ad9d;
      border-radius: 6px;
      color: #645c51;
      background: #fffdfa;
      cursor: pointer;
      font-size: 0.82rem;
      line-height: 1;
      user-select: none;
    }

    .lock-control input:checked + .lock-icon {
      border-color: #2c6f69;
      color: #0f4f49;
      background: #e6f2ef;
    }

    .lock-control input:focus-visible + .lock-icon {
      outline: 2px solid #2c6f69;
      outline-offset: 3px;
    }

    .math-samples {
      display: grid;
      min-height: min(64vh, 620px);
      padding-block: 8px;
      align-items: center;
    }

    math {
      font-family: "SomervilleVF", serif;
      font-variation-settings: "wght" var(--wght), "opsz" var(--opsz), "wdth" var(--wdth);
      font-size: var(--math-size);
      line-height: 1.25;
    }

    .sample-intro {
      margin-bottom: 0.35em;
      font-family: "PlayfairVF", serif;
      font-size: var(--math-size);
      line-height: 1.1;
      font-variation-settings: "wght" var(--wght), "opsz" var(--opsz), "wdth" var(--wdth);
    }

    mfrac {
      linethickness: var(--somerville-fraction-rule-thickness);
    }

    .sample {
      width: 100%;
      overflow-x: auto;
      padding: 32px 0;
      border-bottom: 1px solid #ded7ca;
    }

    body.show-grid::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 9;
      pointer-events: none;
      background-image:
        linear-gradient(to right, rgba(44, 111, 105, 0.24) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(44, 111, 105, 0.24) 1px, transparent 1px);
      background-size: var(--grid-size) var(--grid-size);
    }

    @media (max-width: 720px) {
      .controls {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <button id="controls-toggle" class="panel-toggle" type="button" aria-controls="control-panel" aria-expanded="true" title="Hide controls">Hide</button>

  <section id="control-panel" class="control-panel" aria-label="Variation axis controls">
    <div class="controls">
      <label>
        Weight <span class="value"><input id="wght-value" type="text" inputmode="decimal" value="400" aria-label="Weight value"></span>
        <span id="wght-name" class="axis-name">Regular</span>
        <input id="wght" type="range" min="360" max="900" value="400" step="1">
      </label>

      <label>
        Width <span class="value"><input id="wdth-value" type="text" inputmode="decimal" value="100" aria-label="Width value"></span>
        <span id="wdth-name" class="axis-name">Regular</span>
        <input id="wdth" type="range" min="94" max="114" value="100" step="1">
      </label>

      <label>
        Optical Size <span class="value"><input id="opsz-value" type="text" inputmode="decimal" value="12" aria-label="Optical Size value"></span>
        <span id="opsz-name" class="axis-name">Regular</span>
        <input id="opsz" type="range" min="5" max="96" value="12" step="1">
      </label>

      <label class="lock-control" title="Lock optical size and font size">
        <input id="opsz-size-lock" type="checkbox" aria-label="Lock optical size and font size">
        <span class="lock-icon" aria-hidden="true">&#128274;</span>
      </label>

      <label>
        Font Size <span class="value"><input id="math-size-value" type="text" inputmode="decimal" value="12" aria-label="Font Size value">px</span>
        <input id="math-size" type="range" min="5" max="96" value="12" step="1">
      </label>

      <label>
        Expand <span class="value"><input id="expand-value" type="text" inputmode="decimal" value="2" aria-label="Expand value"></span>
        <input id="expand" type="range" min="0.1" max="8" value="2" step="0.01">
      </label>

      <label>
        Upright Letters
        <input id="upright-toggle" type="checkbox">
      </label>

      <label>
        show more
        <input id="show-extra-axes" type="checkbox">
      </label>
    </div>

    <div id="extra-axes-controls" class="controls extra-controls" hidden>
      <label class="lock-control" title="Lock Math Weight to Weight + 300, ssty1 to 75% opsz, and ssty2 to 60% opsz">
        <input id="mght-weight-lock" type="checkbox" aria-label="Lock Math Weight and script axes" checked>
        <span class="lock-icon" aria-hidden="true">&#128274;</span>
      </label>

      <label>
        Math Weight <span class="value"><input id="MGHT-value" type="text" inputmode="decimal" value="400" aria-label="Math Weight value"></span>
        <input id="MGHT" type="range" min="360" max="900" value="400" step="1">
      </label>

      <label>
        ssty1 <span class="value"><input id="STYA-value" type="text" inputmode="decimal" value="9.0" aria-label="ssty1 value"></span>
        <input id="STYA" type="range" min="5" max="96" value="9" step="0.1">
      </label>

      <label>
        ssty2 <span class="value"><input id="STYB-value" type="text" inputmode="decimal" value="7.2" aria-label="ssty2 value"></span>
        <input id="STYB" type="range" min="5" max="96" value="7.2" step="0.1">
      </label>

      <label>
        show grid
        <input id="grid-toggle" type="checkbox">
      </label>

      <label>
        Grid Size <span class="value"><input id="grid-size-value" type="text" inputmode="decimal" value="1" aria-label="Grid Size value">em</span>
        <input id="grid-size" type="range" min="0.1" max="1" value="1" step="0.01">
      </label>

      <p id="font-status" class="font-status">Font loaded: waiting for server status</p>
    </div>
    <p class="shortcut-help">
      q/w: weight down/up · a/s: width down/up · z/x: optical size down/up ·
      1/2: expand down/up · left/right: sample · up/down: placeholder · r: reset sliders · h: show/hide controls
    </p>
    <p class="shortcut-help">
      This test page is a hack since variable math fonts are not supported.
      Chrome is not displaying big operators.
      (Neither browser respect corner kerns which is a shame)
    </p>
  </section>

  <main>
    <section class="math-samples" aria-label="MathML samples">
      <div id="math-display" class="sample"></div>
    </section>
  </main>

  <div id="font-refresh-toast" class="refresh-toast" role="status" aria-live="polite" aria-hidden="true">
    <div class="refresh-toast-content">
      <span id="font-refresh-toast-icon" class="refresh-toast-icon" aria-hidden="true"></span>
      <span id="font-refresh-toast-text">Refreshing</span>
    </div>
  </div>

