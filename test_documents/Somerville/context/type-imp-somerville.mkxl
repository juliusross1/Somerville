-- Convert source design coordinates to the user coordinates expected by the
-- currently exported fonts. ConTeXt then applies the fonts' avar mappings.
-- Endpoint weights use 360 (the exported minimum), rather than source label 300.
-- Math and Playfair have different exported width mappings.
local weight = { {360,360}, {400,400}, {475,500}, {550,600},
                 {650,700}, {750,800}, {900,900} }
local optical = { {5,5}, {200,6}, {325,7}, {400,8}, {550,12},
                  {640,16}, {700,21}, {800,32}, {860,41}, {900,48},
                  {980,72}, {1020,96}, {1200,1200} }
local textwidth = { {95,88}, {100,100}, {113,112.5} }
local function mapped(value, mapping)
    if value <= mapping[1][1] then return mapping[1][2] end
    for j=2,#mapping do
        local a,b = mapping[j-1],mapping[j]
        if value <= b[1] then
            return a[2] + (value-a[1])*(b[2]-a[2])/(b[1]-a[1])
        end
    end
    return mapping[#mapping][2]
end
for _, entry in ipairs(instances) do
    local name = "somerville-" .. string.lower(entry[1]):gsub("%s+", "-")
    local wght = mapped(entry[3],weight)
    local opsz = mapped(entry[5],optical)
    local mathaxes = string.format(
        "wdth=%g,wght=%g,MGHT=%g,opsz=%g,STYA=%g,STYB=%g,ARLN=%g,ARHD=%g,INSL=%g",
        entry[2],wght,mapped(entry[4],weight),opsz,
        entry[6],entry[7],entry[8],entry[9],entry[10])
    local textaxes = string.format("wdth=%g,wght=%g,opsz=%g",
        mapped(entry[2],textwidth),wght,opsz)
    context.defineSomervilleAxisTypeface(name,mathaxes,textaxes)
    if entry[1] == "Regular" then
        context.defineSomervilleAxisTypeface("somerville",mathaxes,textaxes)
    end
end
\stopluacode
