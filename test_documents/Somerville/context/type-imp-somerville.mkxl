%D \module
%D   [       file=type-imp-somerville,
%D        version=2026.06.30,
%D          title=\CONTEXT\ Typescript Macros,
%D       subtitle=somerville math with Playfair text fonts]

% Relative to test_documents/Somerville/context (the compilation directory).
\gdef\SomervilleFontPath{../../../fonts/Somerville/}

\starttypescriptcollection[somerville]

\definefontfeature[somervilledefault][default][wipemath=no]

\starttypescript[serif][somerville-needlepoint]
  \definefontsynonym[Serif]          [file:\SomervilleFontPath SomervilleMath-Needlepoint.ttf][features=somervilledefault]
  \definefontsynonym[SerifItalic]    [file:\SomervilleFontPath SomervilleMath-Needlepoint.ttf][features=somervilledefault]
  \definefontsynonym[SerifBold]      [file:\SomervilleFontPath SomervilleMath-Needlepoint.ttf][features=somervilledefault]
  \definefontsynonym[SerifBoldItalic][file:\SomervilleFontPath SomervilleMath-Needlepoint.ttf][features=somervilledefault]
\stoptypescript

\starttypescript[math][somerville-needlepoint]
  \definefontsynonym[MathRoman]    [file:\SomervilleFontPath SomervilleMath-Needlepoint.ttf][features={math\mathsizesuffix,mathextra},goodies=somerville]
  \definefontsynonym[MathRomanBold][file:\SomervilleFontPath SomervilleMath-Needlepoint.ttf][features={math\mathsizesuffix,mathextra},goodies=somerville]
\stoptypescript

\starttypescript[serif][somerville-needlepoint-semilight]
