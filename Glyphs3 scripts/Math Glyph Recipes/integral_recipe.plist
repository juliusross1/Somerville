    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createSmartComponentVariants</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>integral</string>
        <key>values</key>
        <string>${variantValues}</string>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>
  </array>
