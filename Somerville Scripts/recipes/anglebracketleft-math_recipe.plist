<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Left and right base glyphs: _smart.anglebracket at height 0.
  Variant .sNN: the same component at height 100 * NN / SizeVariantCount.
  SizeVariantCount lives in recipe_constants.plist; the last variant is 100.
  The variant action also registers the vertical MATH size variants.
  Right components are mirrored left-to-right after every height is set,
  about each component's own bounds. No extra smart source glyph is created.
  Automatic alignment is enabled on both complete families after mirroring.
-->
<plist version="1.0">
<dict>
  <key>formatVersion</key>
  <integer>1</integer>
  <key>kind</key>
  <string>recipe</string>
  <key>constants</key>
  <string>recipe_constants.plist</string>
  <key>name</key>
  <string>anglebracketleft-math</string>
  <key>actions</key>
  <array>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketleft-math</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${GeneratedColor}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketleft-math</string>
        <key>component</key>
        <string>_smart.anglebracket</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisValue</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketleft-math</string>
        <key>axis</key>
        <string>height</string>
        <key>value</key>
        <integer>0</integer>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createSmartComponentVariants</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketleft-math</string>
        <key>axis</key>
        <string>height</string>
        <key>N</key>
        <string>${SizeVariantCount}</string>
        <key>endValue</key>
        <integer>100</integer>
        <key>color</key>
        <string>${GeneratedColor}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketright-math</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${GeneratedColor}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketright-math</string>
        <key>component</key>
        <string>_smart.anglebracket</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisValue</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketright-math</string>
        <key>axis</key>
        <string>height</string>
        <key>value</key>
        <integer>0</integer>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createSmartComponentVariants</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketright-math</string>
        <key>axis</key>
        <string>height</string>
        <key>N</key>
        <string>${SizeVariantCount}</string>
        <key>endValue</key>
        <integer>100</integer>
        <key>color</key>
        <string>${GeneratedColor}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>flipComponentsAcrossYAxis</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketright-math</string>
        <key>variantCount</key>
        <string>${SizeVariantCount}</string>
        <key>requireAll</key>
        <true/>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>enableComponentAlignment</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketleft-math</string>
        <key>variantCount</key>
        <string>${SizeVariantCount}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>enableComponentAlignment</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>anglebracketright-math</string>
        <key>variantCount</key>
        <string>${SizeVariantCount}</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
