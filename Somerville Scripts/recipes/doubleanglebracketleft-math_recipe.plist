			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createSmartComponentVariants</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>doubleanglebracketright-math</string>
				<key>axis</key>
				<string>height</string>
				<key>N</key>
				<string>${SizeVariantCount}</string>
				<key>endValue</key>
				<integer>100</integer>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
