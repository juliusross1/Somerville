				<key>glyph</key>
				<string>doubleanglebracketright-math</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>doubleanglebracketright-math</string>
