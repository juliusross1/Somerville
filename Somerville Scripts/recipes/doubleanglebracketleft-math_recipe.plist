			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentAxisValue</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>doubleanglebracketleft-math</string>
				<key>axis</key>
				<string>height</string>
				<key>value</key>
				<integer>0</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createSmartComponentVariants</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>doubleanglebracketleft-math</string>
				<key>axis</key>
				<string>height</string>
				<key>N</key>
				<string>${SizeVariantCount}</string>
				<key>endValue</key>
				<integer>100</integer>
