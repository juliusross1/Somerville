			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>doubleanglebracketleft-math</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>doubleanglebracketright-math</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
