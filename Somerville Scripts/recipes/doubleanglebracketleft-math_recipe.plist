<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Run _smart.doubleanglebracketleft-math_recipe.plist first.
  Only the smart source has High layers; the exported base glyphs do not.
  Base components use height 0; fixed .sNN variants use
  height 100 * NN / SizeVariantCount and are registered as vertical MATH variants.
  Mirror the complete right family after sizing and enable automatic alignment.
-->
