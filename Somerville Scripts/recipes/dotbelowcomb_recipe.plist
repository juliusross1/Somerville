			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addAnchorAtXComponentMidpoint</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>anchor</key>
				<string>#entry</string>
				<key>componentIndex</key>
				<integer>0</integer>
				<key>x</key>
				<integer>0</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addAnchorAtAdvanceWidthComponentMidpoint</string>
			<key>arguments</key>
