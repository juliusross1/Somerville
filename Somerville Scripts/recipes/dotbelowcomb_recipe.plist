<dict>
	<key>formatVersion</key>
	<integer>1</integer>
	<key>kind</key>
	<string>recipe</string>
	<key>constants</key>
	<string>recipe_constants.plist</string>
	<key>name</key>
	<string>dotbelowcomb (U+0323, from dotaccent)</string>
	<key>parameters</key>
	<dict>
		<key>BelowDotShiftY</key>
		<integer>-868</integer>
	</dict>
	<key>actions</key>
	<array>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setGlyphMetadata</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>category</key>
				<string>Mark</string>
				<key>subCategory</key>
				<string>Nonspacing</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>component</key>
				<string>dotaccent</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentPosition</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>componentIndex</key>
				<integer>0</integer>
				<key>y</key>
				<string>${BelowDotShiftY}</string>
				<key>disableAlignment</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setWidthFromComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>componentIndex</key>
				<integer>0</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setSideMetricKeys</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dotbelowcomb</string>
				<key>left</key>
				<string>=dotaccent</string>
