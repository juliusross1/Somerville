<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Requires _smart.circumflexcomb with its width axis ranging from 0 to 100.
     caroncomb uses width 0; .sNN uses 100 * NN / SizeVariantCount.
     Generate and size all variants before rotating each component 180 degrees
     about its own outline bounds center. Rotation disables automatic alignment
     to preserve the final transforms. Base: Mark/Nonspacing; variants: Mark/Spacing.
     SizeVariantCount and GeneratedColor come from recipe_constants.plist. -->
<plist version="1.0">
<dict>
	<key>formatVersion</key>
	<integer>1</integer>
	<key>kind</key>
	<string>recipe</string>
	<key>constants</key>
	<string>recipe_constants.plist</string>
	<key>name</key>
	<string>caroncomb</string>
	<key>actions</key>
	<array>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setGlyphMetadata</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>category</key>
				<string>Mark</string>
				<key>subCategory</key>
				<string>Nonspacing</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>component</key>
				<string>_smart.circumflexcomb</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentAxisValue</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>axis</key>
				<string>width</string>
				<key>value</key>
				<integer>0</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createSmartComponentVariants</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>axis</key>
				<string>width</string>
				<key>N</key>
				<string>${SizeVariantCount}</string>
				<key>endValue</key>
				<integer>100</integer>
				<key>category</key>
				<string>Mark</string>
				<key>subCategory</key>
				<string>Spacing</string>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>rotateComponents</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>caroncomb</string>
				<key>components</key>
				<array>
					<string>_smart.circumflexcomb</string>
				</array>
				<key>degrees</key>
				<integer>180</integer>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
				<key>requireAll</key>
				<true/>
			</dict>
		</dict>
	</array>
</dict>
</plist>
