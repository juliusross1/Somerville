<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Creates naryintersection (U+22C2) and naryintersection.sNN from _smart.union.
     Match naryunion sizes: base height 5, variants 5 + 95 * NN / SizeVariantCount.
     SizeVariantCount comes from recipe_constants.plist; final smart height 100.
     Generate and align all sizes before flipping each component vertically
     about its own final outline bounds center on every layer.
     The final flip disables alignment to preserve the reflected placement.
     Set LSB and RSB on the base and every variant to match union, then sync.
     createSmartComponentVariants registers the vertical MATH variant chain. -->
<plist version="1.0">
<dict>
	<key>formatVersion</key>
	<integer>1</integer>
	<key>kind</key>
	<string>recipe</string>
	<key>constants</key>
	<string>recipe_constants.plist</string>
	<key>name</key>
	<string>naryintersection (U+22C2)</string>
	<key>actions</key>
	<array>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setGlyphMetadata</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>category</key>
				<string>Symbol</string>
				<key>subCategory</key>
				<string>Math</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>component</key>
				<string>_smart.union</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentAxisValue</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>axis</key>
				<string>height</string>
				<key>value</key>
				<integer>5</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createSmartComponentVariants</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>axis</key>
				<string>height</string>
				<key>N</key>
				<string>${SizeVariantCount}</string>
				<key>endValue</key>
				<integer>95</integer>
				<key>category</key>
				<string>Symbol</string>
				<key>subCategory</key>
				<string>Math</string>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>flipComponents</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>components</key>
				<array>
					<string>_smart.union</string>
				</array>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
				<key>requireAll</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setSideMetricKeys</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>left</key>
				<string>=union</string>
				<key>right</key>
				<string>=union</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>updateMetrics</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryintersection</string>
				<key>mastersOnly</key>
				<false/>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
