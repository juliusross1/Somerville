<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Creates naryunion (U+22C3) and naryunion.sNN from _smart.union.
     Base smart height: 5.
     Variant height: 5 + 95 * NN / SizeVariantCount; the final height is 100.
     createSmartComponentVariants adds increments to the source component's
     height, so endValue is the 95-unit increment range, not the final height.
     SizeVariantCount comes from recipe_constants.plist (currently 20).
     In the two Agate Black masters, interpolate component Weight from 900
     on the base to blackweightadjustment on the last variant.
     Register vertical MATH variants and enable alignment on base and variants. -->
<plist version="1.0">
<dict>
	<key>formatVersion</key>
	<integer>1</integer>
	<key>kind</key>
	<string>recipe</string>
	<key>constants</key>
	<string>recipe_constants.plist</string>
	<key>name</key>
	<string>naryunion (U+22C3)</string>
	<key>actions</key>
	<array>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setGlyphMetadata</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>category</key>
				<string>Symbol</string>
				<key>subCategory</key>
				<string>Math</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>component</key>
				<string>_smart.union</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentAxisValue</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>axis</key>
				<string>height</string>
				<key>value</key>
				<integer>5</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createSmartComponentVariants</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>axis</key>
				<string>height</string>
				<key>N</key>
				<string>${SizeVariantCount}</string>
				<key>endValue</key>
				<integer>95</integer>
				<key>category</key>
				<string>Symbol</string>
				<key>subCategory</key>
				<string>Math</string>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentAxisValue</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>axis</key>
				<string>Weight</string>
				<key>value</key>
				<integer>900</integer>
				<key>endValue</key>
				<string>${blackweightadjustment}</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
				<key>masterNames</key>
				<array>
					<string>Agate Black SemiCondensed Upright</string>
					<string>Agate Black SemiExpanded Upright</string>
				</array>
				<key>componentFilter</key>
				<dict>
					<key>component</key>
					<string>_smart.union</string>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>naryunion</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
