<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Requires an existing overlinecomb glyph.
     Creates spacing assembly parts, each containing overlinecomb:
       .lft: source LSB, RSB 0; .rgt: LSB 0, source RSB; .ext: LSB/RSB 0.
     Alignment is disabled so the explicit sidebearings remain in effect.
     Registers a horizontal MATH assembly on the existing overlinecomb:
       .lft + repeating .ext + .rgt.
     Each nonzero connector is the minimum part outline width across all
     masters (excluding sidebearings), shared by every layer. Special layers
     do not affect the minimum. Outer start/end connectors remain zero. -->
