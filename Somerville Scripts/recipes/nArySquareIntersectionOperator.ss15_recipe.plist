<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Creates nArySquareIntersectionOperator.ss15 and its size variants by
     vertically reflecting _smart.nArySquareUnionOperator.serif about each component bounds center.
     Height runs from 0 to 100 using SizeVariantCount; flip follows alignment.
     Match sidebearings to the corresponding square union and register MATH variants. -->
<plist version="1.0">
<dict>
	<key>formatVersion</key>
	<integer>1</integer>
	<key>kind</key>
	<string>recipe</string>
	<key>constants</key>
	<string>recipe_constants.plist</string>
	<key>name</key>
	<string>nArySquareIntersectionOperator (serif alternate)</string>
	<key>actions</key>
	<array>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setGlyphMetadata</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>category</key>
				<string>Symbol</string>
				<key>subCategory</key>
				<string>Math</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponent</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>component</key>
				<string>_smart.nArySquareUnionOperator.serif</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setComponentAxisValue</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>axis</key>
				<string>height</string>
				<key>value</key>
				<integer>0</integer>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createSmartComponentVariants</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>axis</key>
				<string>height</string>
				<key>N</key>
				<string>${SizeVariantCount}</string>
				<key>endValue</key>
				<integer>100</integer>
				<key>category</key>
				<string>Symbol</string>
				<key>subCategory</key>
				<string>Math</string>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>flipComponents</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>components</key>
				<array>
					<string>_smart.nArySquareUnionOperator.serif</string>
				</array>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
				<key>requireAll</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>setSideMetricKeys</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>left</key>
				<string>=nArySquareUnionOperator.ss15</string>
				<key>right</key>
				<string>=nArySquareUnionOperator.ss15</string>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>updateMetrics</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>nArySquareIntersectionOperator.ss15</string>
				<key>mastersOnly</key>
				<false/>
				<key>variantCount</key>
				<string>${SizeVariantCount}</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
