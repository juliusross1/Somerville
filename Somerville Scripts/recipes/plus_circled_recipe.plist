<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Uses the existing _smart.plus.circled without modifying it.
     N-ary base height is 0; .sNN height is NN * 100 / SizeVariantCount,
     matching nAryCircledDotOperator. With 20 variants, the step is 5. -->
<plist version="1.0">
<dict>
  <key>formatVersion</key>
  <integer>1</integer>

  <key>kind</key>
  <string>recipe</string>

  <key>constants</key>
  <string>recipe_constants.plist</string>

  <key>name</key>
  <string>circled plus operators</string>

  <key>parameters</key>
  <dict>
    <key>axis</key>
    <string>height</string>
    <key>color</key>
    <string>${GeneratedColor}</string>
  </dict>

  <key>actions</key>
  <array>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>plus.circled</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>plus.circled</string>
        <key>component</key>
        <string>_smart.plus.circled</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisValue</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>plus.circled</string>
        <key>axis</key>
        <string>${axis}</string>
        <key>value</key>
        <integer>0</integer>
        <key>componentFilter</key>
        <dict>
          <key>components</key>
          <array>
            <string>_smart.plus.circled</string>
          </array>
        </dict>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryCircledPlusOperator</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryCircledPlusOperator</string>
        <key>component</key>
        <string>_smart.plus.circled</string>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisValue</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryCircledPlusOperator</string>
        <key>axis</key>
        <string>${axis}</string>
        <key>value</key>
        <integer>0</integer>
        <key>componentFilter</key>
        <dict>
          <key>components</key>
          <array>
            <string>_smart.plus.circled</string>
          </array>
        </dict>
      </dict>
    </dict>

    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createSmartComponentVariants</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryCircledPlusOperator</string>
        <key>N</key>
        <string>${SizeVariantCount}</string>
        <key>endValue</key>
        <integer>100</integer>
        <key>axis</key>
        <string>${axis}</string>
        <key>color</key>
        <string>${color}</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
