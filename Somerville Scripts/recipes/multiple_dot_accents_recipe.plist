<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Builds U+0308, U+20DB, and U+20DC from dotaccentcomb.
     The source #entry/#exit anchors control the horizontal spacing.
     Automatic alignment is explicitly enabled on every component.
     The engine refreshes spacing on affected layers after completion. -->
<plist version="1.0">
<dict>
	<key>formatVersion</key>
	<integer>1</integer>
	<key>kind</key>
	<string>recipe</string>
	<key>constants</key>
	<string>recipe_constants.plist</string>
	<key>name</key>
	<string>multiple dot accents (ddot, dddot, ddddot)</string>
	<key>actions</key>
	<array>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dieresiscomb</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponents</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dieresiscomb</string>
				<key>components</key>
				<array>
					<string>dotaccentcomb</string>
					<string>dotaccentcomb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>dieresiscomb</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>threedotsabovecomb</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponents</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>threedotsabovecomb</string>
				<key>components</key>
				<array>
					<string>dotaccentcomb</string>
					<string>dotaccentcomb</string>
					<string>dotaccentcomb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>threedotsabovecomb</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>createGlyph</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>fourdotsabovecomb</string>
				<key>export</key>
				<true/>
				<key>color</key>
				<string>${GeneratedColor}</string>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>addComponents</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>fourdotsabovecomb</string>
				<key>components</key>
				<array>
					<string>dotaccentcomb</string>
					<string>dotaccentcomb</string>
					<string>dotaccentcomb</string>
					<string>dotaccentcomb</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>type</key>
			<string>call</string>
			<key>function</key>
			<string>enableComponentAlignment</string>
			<key>arguments</key>
			<dict>
				<key>glyph</key>
				<string>fourdotsabovecomb</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
