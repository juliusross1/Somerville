<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Uses the existing _smart.nAryUnionOperatorWithDot component.
     Base height is 0; variant .sNN height is NN * 100 / SizeVariantCount.
     With SizeVariantCount = 20, .s01 is 5 and .s20 is 100. -->
<plist version="1.0">
<dict>
  <key>formatVersion</key>
  <integer>1</integer>
  <key>kind</key>
  <string>recipe</string>
  <key>constants</key>
  <string>recipe_constants.plist</string>
  <key>name</key>
  <string>nAryUnionOperatorWithDot</string>
  <key>actions</key>
  <array>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createGlyph</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryUnionOperatorWithDot</string>
        <key>export</key>
        <true/>
        <key>color</key>
        <string>${GeneratedColor}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setGlyphMetadata</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryUnionOperatorWithDot</string>
        <key>category</key>
        <string>Symbol</string>
        <key>subCategory</key>
        <string>Math</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>addComponent</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryUnionOperatorWithDot</string>
        <key>component</key>
        <string>_smart.nAryUnionOperatorWithDot</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>setComponentAxisValue</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryUnionOperatorWithDot</string>
        <key>axis</key>
        <string>height</string>
        <key>value</key>
        <integer>0</integer>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>createSmartComponentVariants</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryUnionOperatorWithDot</string>
        <key>axis</key>
        <string>height</string>
        <key>N</key>
        <string>${SizeVariantCount}</string>
        <key>endValue</key>
        <integer>100</integer>
        <key>category</key>
        <string>Symbol</string>
        <key>subCategory</key>
        <string>Math</string>
        <key>color</key>
        <string>${GeneratedColor}</string>
      </dict>
    </dict>
    <dict>
      <key>type</key>
      <string>call</string>
      <key>function</key>
      <string>enableComponentAlignment</string>
      <key>arguments</key>
      <dict>
        <key>glyph</key>
        <string>nAryUnionOperatorWithDot</string>
        <key>variantCount</key>
        <string>${SizeVariantCount}</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
