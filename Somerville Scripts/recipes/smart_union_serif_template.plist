<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>formatVersion</key>
  <integer>1</integer>
  <key>kind</key>
  <string>template</string>
  <key>actions</key>
  <array>
    <dict>
      <key>action</key><string>createGlyph</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>export</key><false/>
    </dict>
    <dict>
      <key>action</key><string>addComponents</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>components</key>
      <array>
        <string>${Bowl}</string>
        <string>_naryunion.cap.serif</string>
      </array>
    </dict>
    <!-- Scale the left cap while it is the only cap in the glyph. -->
    <dict>
      <key>action</key><string>setHorizontalScale</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>components</key><string>_naryunion.cap.serif</string>
      <key>scale</key><integer>-100</integer>
    </dict>
    <dict>
      <key>action</key><string>addComponent</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>component</key><string>_naryunion.cap.serif</string>
    </dict>
    <dict>
      <key>action</key><string>createHighLayers</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>axis</key><string>height</string>
      <key>lowValue</key><integer>0</integer>
      <key>highValue</key><integer>100</integer>
    </dict>
    <dict>
      <key>action</key><string>setComponentAxisLowHigh</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>axis</key><string>height</string>
      <key>lowValue</key><integer>0</integer>
      <key>highValue</key><integer>100</integer>
    </dict>
    <dict>
      <key>action</key><string>setComponentPosition</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>componentIndex</key><integer>0</integer>
      <key>x</key><integer>0</integer>
      <key>y</key><integer>0</integer>
    </dict>
    <dict>
      <key>action</key><string>alignComponentPairsByAnchors</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>pairs</key>
      <array>
        <dict>
          <key>componentIndexes</key>
          <array><integer>0</integer><integer>1</integer></array>
          <key>baseAnchor</key><string>serif</string>
          <key>markAnchor</key><string>_serif</string>
        </dict>
        <dict>
          <key>componentIndexes</key>
          <array><integer>0</integer><integer>2</integer></array>
          <key>baseAnchor</key><string>serif_right</string>
          <key>markAnchor</key><string>_serif</string>
        </dict>
      </array>
    </dict>
    <dict>
      <key>action</key><string>setWidthFromComponent</string>
      <key>glyph</key><string>${Glyph}</string>
      <key>componentIndex</key><integer>0</integer>
    </dict>
  </array>
</dict>
</plist>
