+/* Experimental opt-in constant corner kerning for prescripts.
+   Requires simple corner fields (e.g. ConTeXt's simplifykerns tweak).
+   This is not a height-dependent OpenType kerning implementation. */
+static scaled tex_aux_prescript_corner_kern(
+    halfword base_font, int base_char, halfword base_size,
+    const scriptdata *script, halfword script_size, int upper)
+{
+    int base_corner = upper ? top_left_kern : bottom_left_kern;
+    int script_corner = upper ? bottom_right_kern : top_right_kern;
+    scaled kern = tex_aux_math_x_size_scaled(
+        base_font,
+        tex_aux_math_kern_at(base_font, base_char, base_corner, 0, 1),
+        base_size);
+    if (script->node && tex_char_exists(script->fnt, script->chr)) {
+        kern += tex_aux_math_x_size_scaled(
+            script->fnt,
+            tex_aux_math_kern_at(script->fnt, script->chr, script_corner, 0, 1),
+            script_size);
+    }
+    return kern;
+}
+
+/* Only a genuinely single-character script supplies an opposite corner.
+   Complex scripts use the delimiter's carried kern alone. Do not let the
+   general analyzer choose the first character of a multi-character list. */
+static int tex_aux_single_prescript_character(halfword script)
+{
+    if (! script) {
+        return 0;
+    }
+    if (node_type(script) == math_char_node) {
+        return 1;
+    }
+    if (node_type(script) == sub_mlist_node) {
+        halfword list = math_kernel_list(script);
+        return list && ! node_next(list) && node_type(list) == simple_noad
+            && ! noad_has_scripts(list) && noad_nucleus(list)
+            && node_type(noad_nucleus(list)) == math_char_node;
+    }
+    return 0;
+}
+
+static scaled tex_aux_fenced_prescript_kern(
+    scaled base_kern, halfword base_font, halfword script,
+    halfword script_size, int upper)
+{
+    if (! base_font || base_kern == MATH_KERN_NOT_FOUND
+        || ! tex_aux_math_engine_control(base_font, math_control_separate_prescript_kerns)) {
+        return 0;
+    }
+    /* Already scaled when the selected delimiter's corners were carried. */
+    scaled kern = base_kern;
+    if (tex_aux_single_prescript_character(script)) {
+        scriptdata data = { 0 };
+        data.node = tex_aux_analyze_script(script, &data);
+        if (data.node && tex_char_exists(data.fnt, data.chr)) {
+            int corner = upper ? bottom_right_kern : top_right_kern;
+            kern += tex_aux_math_x_size_scaled(
+                data.fnt, tex_aux_math_kern_at(data.fnt, data.chr, corner, 0, 1), script_size);
+        }
+    }
+    return kern;
+}
